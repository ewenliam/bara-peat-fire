# Copy to .env and fill in. Never commit .env.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Optional: hard cap on logged Meta API spend in USD (default 20)
META_SPEND_CAP_USD=20

# Live mode (src/live.py): NASA FIRMS map key and a NASA Earthdata token for IMERG Early rain
FIRMS_MAP_KEY=
EARTHDATA_TOKEN=
# Copernicus EWDS key (Drought Code download only, src/drought.py)
EWDS_KEY=

# WhatsApp Cloud API field loop (src/whatsapp_routes.py, src/intake.py, src/replies.py)
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=
# Comma-separated sender numbers allowed to file reports; everyone else is skipped
WA_ALLOWED_SENDERS=
# Set to off to stop Bara replying on WhatsApp
WA_REPLIES=on
# Optional: full path to ffmpeg if it is not on PATH
FFMPEG=

# Muse Glimmer fine-tuning experiments only (src/glimmer_train.py)
FIREWORKS_API_KEY=
